# SMM UP Admin Bot — complete Railway environment-variable template
# Add these in Railway Service -> Variables. Never commit real credentials.
# This service is a TypeScript/Node long-polling worker; it does not use webhooks.

NODE_ENV=production

# Telegram owner-only bot
TELEGRAM_BOT_TOKEN=
# Numeric Telegram user ID of the sole authorized owner.
TELEGRAM_OWNER_ID=
# Independent random value with at least 24 characters; used for protected pending reset state.
ADMIN_BOT_STATE_SECRET=

# MongoDB Atlas — use the same intended production database as Vercel
MONGODB_URI=
MONGODB_DB_NAME=smm_up_db
# Legacy fallback accepted by the bot only when MONGODB_DB_NAME is absent.
DATABASE_NAME=

# Gmail IMAP settlement worker
IMAP_USER=
# Gmail app password; never use or store the mailbox's normal password.
IMAP_PASSWORD=
# One exact trusted sender mailbox, not a domain or substring.
FAMPAY_SENDER_FILTER=no-reply@famapp.in
# Keep false until staging checks pass; set true for the intended production settlement worker.
ENABLE_IMAP_WORKER=false

# Owner-issued temporary-password policy (must match Vercel)
TEMP_PASSWORD_TTL_MINUTES=180
# Allowed values: 1 or 2
TEMP_PASSWORD_MAX_USES=2

# Test/import guard. Production must remain false so long polling and workers start.
ADMIN_BOT_DISABLE_AUTOSTART=false
